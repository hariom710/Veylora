# AI Context Exclusions for Veylora

# Build directories and outputs
target/
**/target/
dist/
build/
out/
coverage/

# Dependencies
node_modules/
vendor/

# Compiler caches and tags
.cache/
.parcel-cache/
.turbo/
.pytest_cache/
__pycache__/
.mypy_cache/
CACHEDIR.TAG
.rustc_info.json

# Logs, stack traces, and error dumps
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
build_output.txt
**/*errors*.txt
**/*_errors*.txt

# Secrets and local configurations
.env
.env.*
!.env.example
*.pem
*.key

# Runtime vaults and test artifacts
test-vault.db
*.db
*.db-wal
*.db-shm
*.tmp
.tmp-*
*.veylora-tmp-*
blobs/

# Generated minified files
*.min.js
*.map

